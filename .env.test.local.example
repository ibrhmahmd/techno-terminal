# ── LOCAL TEST ENV (example) ──
# Copy to .env.test.local; scripts/local_test_db.sh up writes the real file,
# replacing only DATABASE_URL with the disposable 127.0.0.1:55432 database.
# Placeholders only — never commit real values.

DATABASE_URL=postgresql://postgres:CHANGEME@127.0.0.1:55432/techno_test
SUPABASE_URL=https://your-testing-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TWILIO CONFIG
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000

# GMAIL CONFIG
GMAIL_SENDER_ADDRESS=you@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# NOTIFICATION CONFIG
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0
FALLBACK_EMAIL=you@example.com

# Logging Configuration
LOG_LEVEL=INFO
SLOW_REQUEST_MS=5000
JSON_LOGS=false

# Logfire Observability
LOGFIRE_TOKEN=

# Internal report trigger (local/testing only)
INTERNAL_TRIGGER_SECRET=change-me
